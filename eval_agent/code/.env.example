EVAL_AGENT_URL=http://127.0.0.1:3100/internal/v1/agent/runs
EVAL_AGENT_TOKEN=
EVAL_REQUEST_TIMEOUT_SECONDS=240

# Optional overrides for the OpenAI-compatible judge.
# By default the evaluator reuses MODEL_PROVIDER, MODEL_ID and MODEL_API_KEY
# from agent-engine/.env. Set these only when a separate judge is needed.
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_TIMEOUT_SECONDS=120
