# Copy this file to .env.local in the repository root (NOT frontend/.env.local).
# Use the same database settings as your current backend terminal.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/law_kb
JWT_SECRET=local-development-secret-at-least-32-characters
INTERNAL_SERVICE_TOKEN=local-internal-service-token
AGENT_ENGINE_SERVICE_TOKEN=local-agent-service-token
# Optional absolute path; default is mid-layer/.venv/Scripts/python.exe.
LOCAL_PYTHON=
KNOWLEDGE_BACKEND=rag
RAG_BASE_URL=http://127.0.0.1:8001
RAG_MODE=hybrid
RAG_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_MS=65000
RUN_TIMEOUT_MS=180000
# Model settings remain in agent-engine/.env. Do not put API keys here unless needed.
