POSTGRES_PASSWORD=law_agent_dev
JWT_SECRET=replace-with-at-least-32-random-characters
AGENT_ENGINE_SERVICE_TOKEN=replace-with-agent-service-token
INTERNAL_SERVICE_TOKEN=replace-with-knowledge-service-token

# Keep true for an offline end-to-end smoke test. For a real model, set false and fill the rest.
MOCK_MODE=true
MODEL_PROVIDER=mock
MODEL_ID=mock-legal-model
MODEL_API_KEY=
# Use mock only for offline testing. Containers access a host RAG through host.docker.internal.
KNOWLEDGE_BACKEND=rag
RAG_BASE_URL=http://host.docker.internal:8001
RAG_MODE=hybrid
RAG_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_MS=65000
RUN_TIMEOUT_MS=180000
